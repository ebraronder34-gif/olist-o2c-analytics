-- Olist O2C Analytics
-- Delivery Performance vs Customer Review Score

SELECT
    CASE
        WHEN o.order_delivered_customer_date <= o.order_estimated_delivery_date
            THEN 'On Time'
        ELSE 'Late'
    END AS delivery_status,

    COUNT(r.review_score) AS review_count,

    ROUND(AVG(r.review_score), 2) AS avg_review_score

FROM olist_orders_dataset o

JOIN olist_order_reviews_dataset r
    ON o.order_id = r.order_id

WHERE o.order_delivered_customer_date IS NOT NULL
  AND TRIM(o.order_delivered_customer_date) <> ''
  AND o.order_estimated_delivery_date IS NOT NULL
  AND TRIM(o.order_estimated_delivery_date) <> ''

GROUP BY delivery_status

ORDER BY avg_review_score DESC;
-- Validation result:
-- On Time average review score = 4.29
-- Late average review score = 2.57

-- Data-quality note:
-- 2,965 missing delivery dates were stored as empty strings rather than NULL values.
-- Excluding both NULL and empty-string dates aligned SQL results with Power BI.
